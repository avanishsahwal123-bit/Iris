# ── Dockerfile.hooks ────────────────────────────────────────────────────────
# Multi-stage build for iris-hooks (webhook receiver)
# Build context: repo root (needs packages/)
# ────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Copy shared packages first (layer cache)
COPY packages/ packages/

# Copy the service
COPY services/hooks/ services/hooks/

# Download dependencies
WORKDIR /src/services/hooks
RUN go mod download

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/iris-hooks ./cmd/server

# ── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /bin/iris-hooks /bin/iris-hooks

EXPOSE 8080

CMD ["/bin/iris-hooks"]
