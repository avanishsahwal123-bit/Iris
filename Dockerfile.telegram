# ── Dockerfile.telegram ─────────────────────────────────────────────────────
# Multi-stage build for iris-telegram (Telegram bot)
# Build context: repo root (needs packages/)
# ────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Copy shared packages first (layer cache)
COPY packages/ packages/

# Copy the service
COPY services/iris-telegram/ services/iris-telegram/

# Download dependencies
WORKDIR /src/services/iris-telegram
RUN go mod download

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/iris-telegram ./cmd/bot

# ── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /bin/iris-telegram /bin/iris-telegram

CMD ["/bin/iris-telegram"]
